#!/usr/bin/env bats

setup() {
  load test_helper
  setup_env
  load_libs
  # Aquí trace_processor no está instalado: se quita el falso que setup_env deja en el PATH.
  rm "$STUBS/trace_processor"
  hash -r
  DEST="$HOME/.local/bin/trace_processor"
}

# fake_script <versión> [código de salida]: un script de Perfetto falso, en Python como el real, que deja
# registrado cuándo lo ejecutan.
fake_script() {
  export FAKE_INSTALLER_SCRIPT="$BATS_TEST_TMPDIR/trace_processor-$1"
  cat >"$FAKE_INSTALLER_SCRIPT" <<SCRIPT
#!/usr/bin/env python3
# This file has been generated by: tools/release/roll-prebuilts $1
# https://commondatastorage.googleapis.com/perfetto-luci-artifacts/$1/mac-arm64/trace_processor_shell
import os, sys
with open(os.environ["FAKE_LOG"], "a") as log:
    log.write("trace_processor " + " ".join(sys.argv[1:]) + "\n")
print("Perfetto $1-fake")
print("Trace Processor RPC API version: 14")
sys.exit(${2:-0})
SCRIPT
}

@test "instala trace_processor si falta y lo verifica con --version" {
  fake_script v59.1
  run perfetto_install
  [ "$status" -eq 0 ]
  [ -x "$DEST" ]
  grep -q '^curl -fsSL -o .* https://get.perfetto.dev/trace_processor$' "$FAKE_LOG"
  grep -qx 'trace_processor --version' "$FAKE_LOG"
  [[ "$output" == *"trace_processor v59.1 instalado en $DEST"* ]]
  [[ "$output" == *"trace_processor --version: Perfetto v59.1-fake"* ]]
}

@test "la segunda vez no cambia el script" {
  fake_script v59.1
  perfetto_install >/dev/null
  cp "$DEST" "$BATS_TEST_TMPDIR/first"
  run perfetto_install
  [ "$status" -eq 0 ]
  [[ "$output" == *"trace_processor v59.1 ya está al día"* ]]
  cmp "$DEST" "$BATS_TEST_TMPDIR/first"
}

@test "update lo actualiza si el script oficial cambio" {
  fake_script v59.1
  perfetto_install >/dev/null
  fake_script v60.0
  run perfetto_update
  [ "$status" -eq 0 ]
  [[ "$output" == *"trace_processor actualizado: v59.1 → v60.0"* ]]
  cmp "$DEST" "$FAKE_INSTALLER_SCRIPT"
  [ -x "$DEST" ]
}

@test "update no lo instala si falta" {
  fake_script v59.1
  run perfetto_update
  [ "$status" -eq 0 ]
  [[ "$output" == *"Falta trace_processor: corre dev-setup bootstrap"* ]]
  [ ! -e "$DEST" ]
  [ "$(grep -c '^curl' "$FAKE_LOG")" -eq 0 ]
}

@test "no toca un trace_processor ajeno en ~/.local/bin, ni un enlace" {
  fake_script v59.1
  mkdir -p "$HOME/.local/bin"
  printf '#!/bin/sh\necho mio\n' >"$DEST"
  run perfetto_install
  [ "$status" -eq 0 ]
  [[ "$output" == *"no es el trace_processor oficial de Perfetto: no se toca"* ]]
  [ "$(sed -n 2p "$DEST")" = "echo mio" ]
  rm "$DEST"
  cp "$FAKE_INSTALLER_SCRIPT" "$BATS_TEST_TMPDIR/mi-trace_processor"
  ln -s "$BATS_TEST_TMPDIR/mi-trace_processor" "$DEST"
  run perfetto_update
  [[ "$output" == *"no se toca"* ]]
  [ -L "$DEST" ]
  [ "$(grep -c '^curl' "$FAKE_LOG")" -eq 0 ]
}

@test "respeta un trace_processor instalado en otro lugar del PATH" {
  fake_script v59.1
  make_stub trace_processor <<'STUB'
echo "Perfetto propio"
STUB
  run perfetto_install
  [ "$status" -eq 0 ]
  [[ "$output" == *"instalado fuera de dev-setup: se respeta"* ]]
  [ ! -e "$DEST" ]
  [ "$(grep -c '^curl' "$FAKE_LOG")" -eq 0 ]
}

@test "si la descarga falla, avisa, lo deja pendiente y sigue" {
  perfetto_install >/dev/null 2>&1
  [ ! -e "$DEST" ]
  [[ "$DEV_SETUP_NEXT_STEPS" == *"no se pudo descargar trace_processor"* ]]
  run perfetto_install
  [ "$status" -eq 0 ]
  [[ "$output" == *"No se pudo descargar https://get.perfetto.dev/trace_processor"* ]]
}

@test "si lo descargado no es el script de Perfetto, no lo instala" {
  export FAKE_INSTALLER_SCRIPT="$BATS_TEST_TMPDIR/pagina.html"
  printf '<html>error</html>\n' >"$FAKE_INSTALLER_SCRIPT"
  run perfetto_install
  [ "$status" -eq 0 ]
  [[ "$output" == *"no es el script de Perfetto: no se instala"* ]]
  [ ! -e "$DEST" ]
}

@test "si --version falla, avisa y lo deja pendiente" {
  fake_script v59.1 1
  perfetto_install >/dev/null 2>&1
  [ -x "$DEST" ]
  [[ "$DEV_SETUP_NEXT_STEPS" == *"trace_processor --version"* ]]
}

@test "dry-run no descarga ni instala" {
  fake_script v59.1
  DEV_SETUP_DRY_RUN=1 run perfetto_install
  [ "$status" -eq 0 ]
  [[ "$output" == *"[dry-run] curl -fsSL -o '<temporal>' https://get.perfetto.dev/trace_processor"* ]]
  [[ "$output" == *"Si es distinto del instalado, se copia a $DEST"* ]]
  [ ! -e "$DEST" ]
  [ ! -s "$FAKE_LOG" ]
}

@test "doctor muestra la version sin ejecutarlo ni usar la red" {
  fake_script v59.1
  perfetto_install >/dev/null
  : >"$FAKE_LOG"
  run perfetto_doctor
  [ "$status" -eq 0 ]
  [[ "$output" == *"trace_processor v59.1 en $DEST"* ]]
  [[ "$output" == *"El binario nativo se descarga la primera vez"* ]]
  [ ! -s "$FAKE_LOG" ]
  mkdir -p "$HOME/.local/share/perfetto/prebuilts"
  : >"$HOME/.local/share/perfetto/prebuilts/trace_processor_shell-8488edbefadfc4be"
  run perfetto_doctor
  [[ "$output" == *"Binario nativo descargado"* ]]
}

@test "bootstrap instala trace_processor y la segunda vez no cambia nada" {
  fake_script v59.1
  export DEV_SETUP_SKIP_OS_CHECK=1
  run "$DEV_SETUP" bootstrap --yes
  [ "$status" -eq 0 ]
  [[ "$output" == *"==> Perfetto (trace_processor)"*"instalado en $DEST"* ]]
  run "$DEV_SETUP" bootstrap --yes
  [ "$status" -eq 0 ]
  [[ "$output" == *"ya está al día"* ]]
}
