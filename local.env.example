# Configuración de dev-setup para esta máquina. `dev-setup bootstrap` crea local.env
# la primera vez; también puedes copiar este archivo. local.env no se versiona.
#
# Formato: una línea CLAVE=valor, sin espacios ni comentarios en la misma línea.
# Las líneas que no se reconocen se ignoran con un aviso: el archivo nunca se ejecuta.

# Grupos: 1 instala, 0 no instala. bootstrap pregunta por cada uno la primera vez y se cambian con
# --with/--without. Sin línea, el grupo usa el valor por defecto que aparece aquí.

# Android CLI, SDK, skills oficiales de Android, memoria de Android Studio y trace_processor de Perfetto
DEV_SETUP_ANDROID=1

# Emulador de Android y su imagen de sistema (unos 3 GB)
DEV_SETUP_EMULATOR=1

# Temurin 21 y JetBrains Toolbox
DEV_SETUP_IDE=1

# GitHub CLI (gh)
DEV_SETUP_GITHUB=1

# Skills propias de agent-skills y testigo
DEV_SETUP_SKILLS=1

# Claude Code, con sus plugins y su configuración
DEV_SETUP_CLAUDE=1

# nvm, Node.js LTS y pnpm
DEV_SETUP_NODE=0

# Aviso para instalar Xcode, para el target iOS de KMP
DEV_SETUP_IOS=0

# LM Studio, para modelos locales
DEV_SETUP_AI_LOCAL=0

# Warp
DEV_SETUP_TERMINAL=0

# shellcheck y bats-core, para contribuir a dev-setup
DEV_SETUP_DEV_TOOLS=0

# Memoria máxima de Android Studio (-Xmx). Sin esta línea se calcula según la RAM:
# 4096m con menos de 32 GB, 6144m desde 32 GB y 8192m desde 64 GB.
# DEV_SETUP_STUDIO_XMX=6144m

# Agentes para las skills oficiales de Android, separados por comas y con los nombres de
# `android skills list`. bootstrap lo pregunta la primera vez. Sin esta línea, claude-code si está el
# grupo claude. android-studio solo significa ninguno más (Android Studio ya las trae) y common
# (~/.agents/skills) es solo para un agente sin nombre propio: Android Studio las vería dos veces.
# DEV_SETUP_ANDROID_SKILL_AGENTS=claude-code,github-copilot
